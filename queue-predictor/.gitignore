# ── Secrets — NEVER commit these ────────────────────────────────────────────
.env
.env.local
.env.production
.env.development
*.env
!.env.example
.streamlit/secrets.toml

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.whl

# ── Virtual environments ─────────────────────────────────────────────────────
venv/
.venv/
env/
.env/
virtualenv/

# ── YOLO model weights (large — auto-downloaded on first run) ─────────────────
*.pt
*.onnx
*.bin

# ── Large binaries / uploads ─────────────────────────────────────────────────
*.zip
*.mp4
*.avi
*.mov
ngrok*

# ── OS artefacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# ── IDE / editors ────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── Vercel (in case of future migration) ─────────────────────────────────────
.vercel

# ── Streamlit local caches (NOT config.toml — that is committed) ─────────────
.streamlit/cache/
# Note: .streamlit/config.toml is intentionally committed (no secrets)
# Note: .streamlit/secrets.toml is intentionally excluded (see line 8)

# ── Scratch / one-off dev scripts ────────────────────────────────────────────
_*.py
_*.txt
full_audit.py
verify_e2e.py
app_clean.py
cf_output.txt

# ── Pytest / coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── Deployment artifacts ──────────────────────────────────────────────────────
.railway/

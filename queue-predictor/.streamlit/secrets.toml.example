# Streamlit Cloud Secrets — TEMPLATE
# ─────────────────────────────────────────────────────────────────────────────
# This file shows the structure for .streamlit/secrets.toml.
# The REAL secrets.toml is in .gitignore and must NEVER be committed.
#
# HOW TO USE ON STREAMLIT COMMUNITY CLOUD:
#   1. Go to your app dashboard on share.streamlit.io
#   2. Click "Settings" → "Secrets"
#   3. Paste the contents below with your real values filled in
#   4. Save — Streamlit Cloud injects these as st.secrets at runtime
# ─────────────────────────────────────────────────────────────────────────────

# Groq LLM key — used for AI narrative alert generation
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY = "your_groq_api_key_here"
